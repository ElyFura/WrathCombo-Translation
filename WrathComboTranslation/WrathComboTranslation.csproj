<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <!-- Metadata -->
    <PropertyGroup>
        <Authors>ElyFura</Authors>
        <Version>0.2.0.0</Version>
        <Description>Community translation overlay for Wrath Combo</Description>
        <PackageProjectUrl>https://github.com/ElyFura/WrathCombo-Translation</PackageProjectUrl>
        <PackageId>WrathComboTranslation</PackageId>
        <Product>WrathComboTranslation</Product>
    </PropertyGroup>

    <!-- Build Parameters -->
    <PropertyGroup>
        <AssemblyName>WrathComboTranslation</AssemblyName>
        <RootNamespace>WrathComboTranslation</RootNamespace>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Configurations>Debug;Release</Configurations>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <LangVersion>preview</LangVersion>
        <Platforms>x64</Platforms>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!-- Required Paths -->
    <PropertyGroup>
        <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
        <DalamudDevPlugins>$(appdata)\XIVLauncher\devPlugins\WrathComboTranslation\</DalamudDevPlugins>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <DalamudLibPath>$(HOME)/.xlcore/dalamud/Hooks/dev/</DalamudLibPath>
        <DalamudDevPlugins>$(HOME)/.xlcore/devPlugins/WrathComboTranslation/</DalamudDevPlugins>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DalamudLibPath>$(HOME)/Library/Application Support/XIV on Mac/dalamud/Hooks/dev/</DalamudLibPath>
        <DalamudDevPlugins>$(HOME)/Library/Application Support/XIV on Mac/devPlugins/WrathComboTranslation/</DalamudDevPlugins>
    </PropertyGroup>

    <!-- Path Override for CI, which has no XIVLauncher install and fetches Dalamud itself.
         Last of the path overrides, so it wins over the per-OS defaults above. -->
    <PropertyGroup Condition="'$(DALAMUD_HOME)' != ''">
        <DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>$(DalamudDevPlugins)</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>bin\Release</OutputPath>
    </PropertyGroup>

    <!-- Dalamud Packaging -->
    <ItemGroup>
        <PackageReference Include="DalamudPackager" Version="15.0.0" />
    </ItemGroup>

    <!-- Harmony rewrites the string literals Wrath hard-codes into its UI (see Services/LiteralPatcher.cs).
         ExcludeAssets="runtime": it must NOT end up beside the plugin, because Dalamud would then load it
         into the plugin's collectible load context, where every Patch() call fails. It is embedded below
         and pushed into the default context at startup instead - see Services/HarmonyBootstrap.cs. -->
    <PropertyGroup>
        <HarmonyVersion>2.4.2</HarmonyVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" ExcludeAssets="runtime" />
        <EmbeddedResource Include="$(NuGetPackageRoot)lib.harmony\$(HarmonyVersion)\lib\net10.0\0Harmony.dll">
            <LogicalName>WrathComboTranslation.0Harmony.dll</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Checked at the source rather than on the output: a copy next to the plugin lands in the collectible
         load context and breaks every patch, so dropping ExcludeAssets="runtime" fails the build instead. -->
    <Target Name="VerifyHarmonyEmbedded" AfterTargets="ResolveReferences">
        <Error Condition="!Exists('$(NuGetPackageRoot)lib.harmony\$(HarmonyVersion)\lib\net10.0\0Harmony.dll')"
               Text="0Harmony.dll not found in the package cache - it must be embedded (see Services/HarmonyBootstrap.cs)" />
        <Error Condition="'@(ReferenceCopyLocalPaths->AnyHaveMetadataValue('Filename', '0Harmony'))' == 'true'"
               Text="0Harmony.dll would be copied next to the plugin, where every patch fails. Keep ExcludeAssets=&quot;runtime&quot; on the PackageReference." />
    </Target>

    <!-- Translation packs ship embedded; loose files in the config dir override them. -->
    <ItemGroup>
        <EmbeddedResource Include="Translations\**\*.json" />
    </ItemGroup>

    <ItemGroup>
        <None Update="WrathComboTranslation.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Dalamud Libraries -->
    <ItemGroup>
        <Reference Include="Dalamud">
            <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Dalamud.Bindings.ImGui">
            <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

</Project>
